#!/usr/bin/env bash
# Hyprveil maintenance command.
set -uo pipefail

REPO="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
. "$REPO/scripts/lib/install-common.sh"

FAIL=0
WARN=0

usage() {
    cat <<'EOF'
Usage: ./hyprveil <command> [options]

Commands:
  setup             First-run setup: detect monitors, pick keyboard, apps,
                    idle timers, wallpaper, accent, motion, and notification
                    backend, preview the result, then deploy. Safe to re-run.
                    Options: --preview, --ensure, --yes, and a flag for every
                    choice (see ./scripts/10-first-run-setup.sh --help).
  doctor            Read-only health report for Fedora support, dependencies,
                    config, shell wiring, and Hyprveil state.
  update            Preview repository changes, back up and atomically deploy
                    the managed config trees, then validate before reloading.
                    Options: --preview (show changes and exit), --yes.
  rollback          List timestamped backups and restore a selected snapshot.
                    Options: --list, --backup <name>, --yes.
  uninstall         Back up and remove Hyprveil-owned user config after
                    confirmation. State and backups are preserved by default.
                    Options: --export-state <dir>, --purge-state, --sddm, --yes.
EOF
}

redact() {
    local value=$1
    if [ -n "${HOME:-}" ]; then
        value=${value//$HOME/\~}
    fi
    printf '%s\n' "$value"
}

status_ok() {
    printf '  OK   %s\n' "$*"
}

status_warn() {
    WARN=$((WARN + 1))
    printf '  WARN %s\n' "$*"
}

status_fail() {
    FAIL=$((FAIL + 1))
    printf '  FAIL %s\n' "$*"
}

section() {
    printf '\n== %s ==\n' "$*"
}

have() {
    command -v "$1" >/dev/null 2>&1
}

installed_package_or_command() {
    local package=$1 command=$2
    have "$command" && return 0
    have rpm && rpm -q "$package" >/dev/null 2>&1
}

json_valid() {
    local file=$1 filter=$2
    have jq || return 2
    jq -e "$filter" "$file" >/dev/null 2>&1
}

check_fedora() {
    local supported release found=0 repos repo official_count=0 third_party_count=0
    section "Fedora And Repositories"
    if hv_load_fedora; then
        supported=$(hv_supported_releases)
        for release in $supported; do
            [ "$HV_FEDORA_VERSION" = "$release" ] && found=1
        done
        if [ "$found" -eq 1 ]; then
            status_ok "$HV_OS_NAME is supported ($supported)"
        else
            status_warn "$HV_OS_NAME is outside the release-tested pair ($supported)"
        fi
    else
        status_fail "Fedora release could not be identified; package guidance may be wrong"
    fi

    if ! have "${HYPRVEIL_DNF:-dnf}"; then
        status_warn "dnf is unavailable; enabled package sources cannot be reported"
        return
    fi
    repos=$(hv_enabled_repo_ids || true)
    if [ -z "$repos" ]; then
        status_warn "dnf reported no enabled repositories"
        return
    fi
    while IFS= read -r repo; do
        [ -n "$repo" ] || continue
        if hv_is_official_repo "$repo"; then
            official_count=$((official_count + 1))
        else
            third_party_count=$((third_party_count + 1))
        fi
    done <<<"$repos"
    status_ok "enabled repositories: $official_count official, $third_party_count third-party"
    if [ "$third_party_count" -gt 0 ]; then
        printf '       Third-party repositories are enabled; package installs still prefer official Fedora sources first.\n'
    fi
}

check_dependencies() {
    local importance package command feature notification_backend required_missing=0 optional_missing=0 checked_count=0
    section "Dependencies"
    notification_backend=$(hv_notification_backend || true)
    while IFS='|' read -r importance package command feature; do
        [ -n "$importance" ] || continue
        [[ "$importance" = \#* ]] && continue
        if [ "$importance" = backend ]; then
            case "$notification_backend:$package" in
                swaync:SwayNotificationCenter|mako:mako|quickshell:quickshell) importance=required ;;
                *) continue ;;
            esac
        fi
        checked_count=$((checked_count + 1))
        if installed_package_or_command "$package" "$command"; then
            continue
        fi
        if [ "$importance" = required ]; then
            required_missing=$((required_missing + 1))
            status_fail "missing required package or command for $feature: $package ($command)"
        else
            optional_missing=$((optional_missing + 1))
        fi
    done < "$REPO/scripts/data/dependencies.tsv"

    if [ "$required_missing" -eq 0 ]; then
        status_ok "$checked_count relevant dependencies checked; no required dependency is missing"
    fi
    if [ "$optional_missing" -gt 0 ]; then
        status_warn "$optional_missing optional dependencies are missing; optional controls may hide or degrade"
    fi
    if [ -s "$HV_SOURCE_LOG" ]; then
        status_ok "package source log exists at $(redact "$HV_SOURCE_LOG")"
    else
        status_warn "no package source log yet; run ./install.sh or ./scripts/09-dependency-report.sh"
    fi
}

check_config() {
    local config="$HV_CONFIG_HOME/hypr/hyprland.conf"
    section "Hyprland And Shell"
    if [ -f "$config" ]; then
        status_ok "Hyprland config found at $(redact "$config")"
    else
        status_fail "Hyprland config is missing at $(redact "$config")"
        printf '       Recovery: ./install.sh, then select deployment when prompted.\n'
        return
    fi

    if have Hyprland; then
        if Hyprland --verify-config -c "$config" >/dev/null 2>&1; then
            status_ok "Hyprland --verify-config accepts the deployed config"
        else
            status_fail "Hyprland --verify-config rejected the deployed config"
            printf '       Recovery: ./scripts/03-test-config.sh, then inspect hyprctl configerrors in-session.\n'
        fi
    else
        status_warn "Hyprland is not installed, so config parse health could not be checked"
    fi

    if [ -f "$HV_CONFIG_HOME/quickshell/shell.qml" ]; then
        status_ok "Quickshell config is deployed"
    else
        status_fail "Quickshell config is missing at $(redact "$HV_CONFIG_HOME/quickshell/shell.qml")"
    fi

    if have quickshell; then
        if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
            if pgrep -u "${USER:-$(id -un)}" -x quickshell >/dev/null 2>&1; then
                status_ok "Quickshell process is running in this Hyprland session"
            else
                status_warn "Hyprland is running but no quickshell process was found"
                printf '       Recovery: quickshell\n'
            fi
        else
            status_ok "quickshell command is installed; live process check skipped outside Hyprland"
        fi
    else
        status_fail "quickshell command is missing"
    fi
}

check_state_file() {
    local label=$1 file=$2 filter=$3 recovery=$4
    if [ ! -e "$file" ]; then
        status_warn "$label state is not selected yet"
        printf '       Recovery: %s\n' "$recovery"
        return
    fi
    if [ ! -r "$file" ]; then
        status_fail "$label state is not readable at $(redact "$file")"
        return
    fi
    case "$(json_valid "$file" "$filter"; printf '%s' "$?")" in
        0) status_ok "$label state is valid" ;;
        2) status_warn "jq is unavailable; $label JSON state could not be schema-checked" ;;
        *) status_fail "$label state is malformed at $(redact "$file")"; printf '       Recovery: %s\n' "$recovery" ;;
    esac
}

check_state() {
    local backend motion profile accent_file wallpaper_file pins_file hardware_file
    section "Hyprveil State"

    backend=$(hv_notification_backend || true)
    case "$backend" in
        quickshell|swaync|mako) status_ok "notification backend: $backend" ;;
        *) status_fail "notification backend is missing or invalid"; printf '       Recovery: ./scripts/07-select-notification-backend.sh --backend quickshell\n' ;;
    esac

    hardware_file="$HV_STATE_HOME/hardware-profile.conf"
    if [ -r "$hardware_file" ]; then
        profile=$(awk -F= '
            $1 == "form_factor" {form=$2}
            $1 == "gpu" {gpu=$2}
            END {
                if ((form == "desktop" || form == "laptop" || form == "generic") &&
                    (gpu == "intel" || gpu == "amd" || gpu == "nvidia" || gpu == "generic")) {
                    print form " / " gpu
                }
            }' "$hardware_file")
        if [ -n "$profile" ]; then
            status_ok "hardware profile: $profile"
        else
            status_fail "hardware profile is malformed at $(redact "$hardware_file")"
            printf '       Recovery: ./scripts/06-select-profile.sh\n'
        fi
    else
        status_warn "hardware profile is not selected"
        printf '       Recovery: ./scripts/06-select-profile.sh\n'
    fi

    motion="$HV_STATE_HOME/motion-profile"
    if [ -r "$motion" ]; then
        IFS= read -r profile < "$motion" || true
        case "$profile" in
            standard|reduced) status_ok "motion profile: $profile" ;;
            *) status_fail "motion profile is invalid"; printf '       Recovery: ~/.config/hypr/scripts/motion-profile.sh --ensure\n' ;;
        esac
    else
        status_warn "motion profile is not selected"
        printf '       Recovery: ~/.config/hypr/scripts/motion-profile.sh --ensure\n'
    fi

    pins_file="$HV_STATE_HOME/dock-pins.json"
    # shellcheck disable=SC2088  # recovery hints display ~ literally to the user
    check_state_file "dock pins" "$pins_file" \
        'type == "array" and length <= 10 and all(.[]; type == "object" and (.desktop_id | type == "string") and (.app_id | type == "string"))' \
        '~/.config/hypr/scripts/dock-manager.sh list'

    wallpaper_file="$HV_STATE_HOME/wallpapers.json"
    # shellcheck disable=SC2088  # recovery hints display ~ literally to the user
    check_state_file "wallpaper" "$wallpaper_file" \
        'type == "object" and .version == 1 and (.fallback | type == "object") and (.fallback.path | type == "string") and (.fallback.fit == "cover" or .fallback.fit == "contain") and (.monitors | type == "object") and all(.monitors[]; type == "object" and (.path | type == "string") and (.fit == "cover" or .fit == "contain"))' \
        '~/.config/hypr/scripts/wallpaper.sh restore'

    accent_file="$HV_STATE_HOME/accent.json"
    # shellcheck disable=SC2088  # recovery hints display ~ literally to the user
    check_state_file "accent" "$accent_file" \
        'type == "object" and .version == 1 and (.accent | type == "string") and (.accent | test("^#[0-9a-fA-F]{6}$")) and (.source | type == "string") and (.auto | type == "boolean") and ((has("chromeAlpha") | not) or (.chromeAlpha | test("^[01](\\.[0-9]+)?$"))) and ((has("chromeBand") | not) or (.chromeBand | test("^[0-9a-f]{6}$")))' \
        '~/.config/hypr/scripts/accent.sh render'
}

check_managed_trees() {
    local name path missing=0 backend
    section "Managed Trees"
    for name in hypr quickshell waybar kitty rofi wlogout gtk-3.0 gtk-4.0 fontconfig; do
        path="$HV_CONFIG_HOME/$name"
        if [ -e "$path" ]; then
            status_ok "$name deployed"
        else
            missing=$((missing + 1))
            status_warn "$name is not deployed at $(redact "$path")"
        fi
    done
    if [ "$missing" -gt 0 ]; then
        printf '       Recovery: ./install.sh, then select deployment when prompted.\n'
    fi

    backend=$(hv_notification_backend || printf 'quickshell\n')
    for name in ags swaync mako; do
        [ "$name" = "$backend" ] && continue
        path="$HV_CONFIG_HOME/$name"
        if [ -e "$path" ]; then
            status_warn "stale inactive backend tree remains at $(redact "$path")"
            printf '       Recovery: rerun ./install.sh and deploy configs to back it up and remove it.\n'
        fi
    done
}

doctor() {
    printf 'Hyprveil doctor is read-only; it does not repair or rewrite state.\n'
    printf 'Config home: %s\n' "$(redact "$HV_CONFIG_HOME")"
    printf 'State home:  %s\n' "$(redact "$HV_STATE_HOME")"
    check_fedora
    check_dependencies
    check_config
    check_state
    check_managed_trees

    printf '\n== Summary ==\n'
    if [ "$FAIL" -gt 0 ]; then
        printf 'Doctor found %s failure(s) and %s warning(s).\n' "$FAIL" "$WARN"
        return 1
    fi
    if [ "$WARN" -gt 0 ]; then
        printf 'Doctor found no failures and %s warning(s).\n' "$WARN"
        return 0
    fi
    printf 'Doctor found no failures or warnings.\n'
}

update() {
    local preview_only=0
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --preview) preview_only=1 ;;
            --yes|-y) export HYPRVEIL_ASSUME_YES=1 ;;
            *) usage >&2; exit 2 ;;
        esac
        shift
    done

    if [ ! -d "$HV_CONFIG_HOME/hypr" ]; then
        printf 'No deployed Hyprveil configuration found at %s.\n' "$(redact "$HV_CONFIG_HOME")" >&2
        printf 'Run ./install.sh for the first deployment.\n' >&2
        return 1
    fi

    if ! hv_preview_config_changes; then
        printf '\nDeployed configuration already matches the repository; nothing to update.\n'
        return 0
    fi
    if [ "$preview_only" -eq 1 ]; then
        printf '\nPreview only; no changes were made. Run without --preview to apply.\n'
        return 0
    fi

    printf '\n'
    if ! hv_confirm "Back up and deploy these changes now?"; then
        printf 'Update cancelled; no changes were made.\n'
        return 0
    fi

    if ! hv_deploy_configs; then
        hv_bad "deployment failed; see the errors above. Existing configuration was not partially replaced."
        return 1
    fi
    [ -f "$HV_STATE_HOME/hardware-profile.conf" ] && \
        "$REPO/scripts/06-select-profile.sh" --ensure >/dev/null 2>&1 || true
    [ -f "$HV_NOTIFICATION_STATE" ] && \
        "$REPO/scripts/07-select-notification-backend.sh" --ensure >/dev/null 2>&1 || true
    # Regenerate the setup-owned files (local.conf, apps.conf, hypridle.conf)
    # that a fresh deploy just reset to their repository defaults.
    "$REPO/scripts/10-first-run-setup.sh" --ensure >/dev/null 2>&1 || true
    if [ -x "$HV_CONFIG_HOME/hypr/scripts/motion-profile.sh" ]; then
        "$HV_CONFIG_HOME/hypr/scripts/motion-profile.sh" --ensure >/dev/null 2>&1 || true
    fi
    if [ -x "$HV_CONFIG_HOME/hypr/scripts/accent.sh" ]; then
        "$HV_CONFIG_HOME/hypr/scripts/accent.sh" render >/dev/null 2>&1 || true
    fi

    printf '\nValidating deployed configuration before reload...\n'
    if ! cmp -s "$REPO/config/hypr/hyprland.conf" "$HV_CONFIG_HOME/hypr/hyprland.conf"; then
        hv_bad "deployed hyprland.conf does not match the managed template; not reloading."
        printf '       Recovery: ./hyprveil rollback\n' >&2
        return 1
    fi
    if have Hyprland && ! Hyprland --verify-config -c "$HV_CONFIG_HOME/hypr/hyprland.conf" >/dev/null 2>&1; then
        hv_bad "Hyprland rejected the deployed config; not reloading."
        printf '       Recovery: ./hyprveil rollback\n' >&2
        return 1
    fi
    hv_ok "deployed configuration validated"
    hv_reload_live_session
    printf 'Update complete.\n'
}

rollback() {
    local list_only=0 selected='' choice line name summary count=0
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --list) list_only=1 ;;
            --backup) shift; selected=${1:-} ;;
            --yes|-y) export HYPRVEIL_ASSUME_YES=1 ;;
            *) usage >&2; exit 2 ;;
        esac
        shift
    done

    local backups
    backups=$(hv_list_backups)
    if [ -z "$backups" ]; then
        printf 'No backups found under %s.\n' "$(redact "$HV_STATE_HOME/backups")" >&2
        return 1
    fi

    local -a names=() summaries=()
    while IFS=$'\t' read -r name summary; do
        [ -n "$name" ] || continue
        names+=("$name")
        summaries+=("$summary")
    done <<<"$backups"

    printf 'Available backups (newest first):\n'
    for count in "${!names[@]}"; do
        printf '  %2d) %s  [%s]\n' "$((count + 1))" "${names[$count]}" "${summaries[$count]}"
    done
    [ "$list_only" -eq 1 ] && return 0

    if [ -n "$selected" ]; then
        for count in "${!names[@]}"; do
            [ "${names[$count]}" = "$selected" ] && line=$((count + 1))
        done
        if [ -z "${line:-}" ]; then
            printf 'No backup named %s.\n' "$selected" >&2
            return 1
        fi
        choice=$line
    elif [ "${HYPRVEIL_ASSUME_YES:-0}" = 1 ]; then
        choice=1
        printf 'Selecting newest backup %s [automatic].\n' "${names[0]}"
    else
        read -r -p "Restore which backup? [1-${#names[@]}, blank to cancel] " choice
        if [ -z "$choice" ]; then
            printf 'Rollback cancelled; no changes were made.\n'
            return 0
        fi
    fi

    if ! [[ "$choice" =~ ^[0-9]+$ ]] || [ "$choice" -lt 1 ] || [ "$choice" -gt "${#names[@]}" ]; then
        printf 'Invalid selection: %s\n' "$choice" >&2
        return 1
    fi

    selected=${names[$((choice - 1))]}
    local snapshot="$HV_STATE_HOME/backups/$selected"
    if ! hv_confirm "Restore config from backup $selected? Current config is backed up first."; then
        printf 'Rollback cancelled; no changes were made.\n'
        return 0
    fi
    if ! hv_restore_backup "$snapshot"; then
        return 1
    fi
    hv_reload_live_session
    printf 'Rollback complete.\n'
}

uninstall() {
    local export_dir='' purge_state=0 do_sddm=0
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --export-state) shift; export_dir=${1:-} ;;
            --purge-state) purge_state=1 ;;
            --sddm) do_sddm=1 ;;
            --yes|-y) export HYPRVEIL_ASSUME_YES=1 ;;
            *) usage >&2; exit 2 ;;
        esac
        shift
    done

    printf 'This removes Hyprveil-owned user configuration under %s.\n' "$(redact "$HV_CONFIG_HOME")"
    printf 'Backups and persistent state under %s are preserved by default.\n' "$(redact "$HV_STATE_HOME")"
    printf 'Installed packages and enabled repositories are never removed.\n'
    if ! hv_confirm "Back up and remove Hyprveil-managed config now?"; then
        printf 'Uninstall cancelled; no changes were made.\n'
        return 0
    fi

    if [ -n "$export_dir" ]; then
        mkdir -p "$export_dir"
        if cp -a "$HV_STATE_HOME/." "$export_dir/" 2>/dev/null; then
            printf 'Exported state and backups to %s\n' "$(redact "$export_dir")"
        else
            hv_warn "could not export state to $(redact "$export_dir")"
        fi
    fi

    hv_remove_managed_config

    if [ "$do_sddm" -eq 1 ]; then
        uninstall_sddm
    elif [ -e /etc/sddm.conf.d/hyprveil.conf ] || [ -e /usr/share/sddm/themes/hyprveil ]; then
        printf 'A system SDDM theme or selection installed by Hyprveil is still present.\n'
        printf 'Re-run with --sddm to restore the previous SDDM configuration (requires sudo).\n'
    fi

    if [ "$purge_state" -eq 1 ]; then
        if hv_confirm "Permanently delete all Hyprveil state and backups under $(redact "$HV_STATE_HOME")?"; then
            rm -rf "$HV_STATE_HOME"
            printf 'Removed Hyprveil state and backups.\n'
        else
            printf 'Kept Hyprveil state and backups.\n'
        fi
    else
        printf 'Preserved Hyprveil state and backups under %s.\n' "$(redact "$HV_STATE_HOME")"
    fi
    printf 'Uninstall complete. The Hyprveil repository checkout was not removed.\n'
}

# Restore the display manager's SDDM configuration to its pre-Hyprveil state.
# The most recent backup that captured the prior theme selection or theme tree
# is restored; otherwise the Hyprveil-added files are removed. The active
# display manager is never switched here — that stays a deliberate manual step.
uninstall_sddm() {
    hv_uninstall_sddm
}

case "${1:-}" in
    setup) shift; exec "$REPO/scripts/10-first-run-setup.sh" "$@" ;;
    doctor) shift; [ "$#" -eq 0 ] || { usage >&2; exit 2; }; doctor ;;
    update) shift; update "$@" ;;
    rollback) shift; rollback "$@" ;;
    uninstall) shift; uninstall "$@" ;;
    -h|--help|'') usage ;;
    *) usage >&2; exit 2 ;;
esac
