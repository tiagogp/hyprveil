/* Requires rofi-wayland (Fedora package). Theme implements the design's
   launcher: 480px glass panel, search header, icon rows, accent selection. */

configuration {
    modi: "drun,run";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    display-drun: "";
    drun-display-format: "{name}";
    font: "Geist 12";
    terminal: "kitty";
}

@theme "hyprveil"
