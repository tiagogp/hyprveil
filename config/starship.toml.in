# Starship prompt — GENERATED from this .in by hypr/scripts/accent.sh.
# The palette is templated from neutrals.conf (the neutrals) and the accent
# state (the accent), so it tracks the wallpaper and any palette edit. Do not
# edit the generated starship.toml; edit this template or neutrals.conf, then run
# `~/.config/hypr/scripts/accent.sh render`. See docs/CONFIGURATION.md.
# Minimal two-line prompt: user + dir + git on top, accent ❯ below.
"$schema" = 'https://starship.rs/config-schema.json'

format = "$username$directory$git_branch$git_status$cmd_duration$line_break$character"
add_newline = true
palette = 'hyprveil'

[palettes.hyprveil]
accent = '@accent@'
accent_hover = '@accent-hover@'
text = '@text@'
muted = '@text-muted@'
warning = '@warning@'
error = '@error@'
success = '@success@'

[username]
show_always = true
style_user = 'muted'
style_root = 'bold error'
format = '[$user]($style) '

[directory]
style = 'bold accent'
truncation_length = 3
truncate_to_repo = true
format = '[$path]($style)[$read_only](muted) '

[git_branch]
symbol = ' '
style = 'muted'
format = 'on [$symbol$branch]($style) '

[git_status]
style = 'warning'
format = '([$all_status$ahead_behind]($style) )'

[cmd_duration]
min_time = 2000
style = 'muted'
format = 'took [$duration]($style) '

[character]
success_symbol = '[❯](bold accent)'
error_symbol = '[❯](bold error)'
