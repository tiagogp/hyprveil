// GENERATED from Tokens.qml.in by hypr/scripts/theme.sh — do not edit.
// Edit hypr/tokens.conf, then run `theme.sh render`. See docs/TOKENS.md.
//
// This is the whole reason the shell is QML: every value below is a real
// property, so `radius: Tokens.radiusMd` is a live binding. There is no unit
// problem (tokens.conf stores 14, QML wants 14), and no stylesheet to discard
// when one declaration is wrong — the GTK failure modes the CSS consumers have
// to defend against simply do not exist here.
pragma Singleton

// QtQuick, not just Quickshell: the `color` properties in the neutrals block are
// a QtQuick type, and a Singleton without it fails to load.
import QtQuick
import Quickshell

Singleton {
    // ---------------------------------------------------------------------
    // Radius — a 4px ramp whose step equals spacing1, so nesting is concentric
    // by construction: panel > card > control > chip.
    // ---------------------------------------------------------------------
    readonly property int radiusXs:   @radius-xs@
    readonly property int radiusSm:   @radius-sm@
    readonly property int radiusMd:   @radius-md@
    readonly property int radiusLg:   @radius-lg@
    readonly property int radiusPill: @radius-pill@

    // ---------------------------------------------------------------------
    // Spacing — 4px grid with three half-steps. Half-steps are legal for
    // padding INSIDE a control; margins, gaps, and grid spacing use full steps.
    // ---------------------------------------------------------------------
    readonly property int spacingHair: @space-hair@
    readonly property int spacing1:    @space-1@
    readonly property int spacing1h:   @space-1h@
    readonly property int spacing2:    @space-2@
    readonly property int spacing2h:   @space-2h@
    readonly property int spacing3:    @space-3@
    readonly property int spacing4:    @space-4@
    readonly property int spacing5:    @space-5@
    readonly property int spacing6:    @space-6@
    readonly property int spacing8:    @space-8@

    // ---------------------------------------------------------------------
    // Type
    // ---------------------------------------------------------------------
    readonly property string fontUi:      "@font-ui@"
    readonly property string fontUiIcons: "@font-ui-icons@"
    readonly property string fontMono:    "@font-mono@"

    readonly property int text2xs: @text-2xs@
    readonly property int textXs:  @text-xs@
    readonly property int textSm:  @text-sm@
    readonly property int textMd:  @text-md@
    readonly property int textLg:  @text-lg@
    readonly property int textXl:  @text-xl@

    // One-offs, named so they are not mistaken for scale steps.
    readonly property real textMono:   @text-mono@
    readonly property int  textAvatar: @text-avatar@
    readonly property int  textClock:  @text-clock@

    readonly property int weightRegular:  @weight-regular@
    readonly property int weightMedium:   @weight-medium@
    readonly property int weightSemibold: @weight-semibold@
    readonly property int weightBold:     @weight-bold@

    // Icon glyph sizes are not type: a 16px icon and 16px text are different
    // optical systems, and coupling them means fixing one breaks the other.
    readonly property int iconSm:   @icon-sm@
    readonly property int iconMd:   @icon-md@
    readonly property int iconLg:   @icon-lg@
    readonly property int iconXl:   @icon-xl@
    readonly property int iconHit:  @icon-hit@
    readonly property int iconRing: @icon-ring@

    // ---------------------------------------------------------------------
    // Elevation — surface alpha, hairline opacity, and shadow move TOGETHER.
    // Tiering alpha alone is why nothing read as layered before.
    //
    // Tier 0 sits at 0.88 rather than a glassier 0.82 because 0.82 puts muted
    // text at 4.05:1 over a bright wallpaper, under the 4.5:1 floor.
    // ---------------------------------------------------------------------
    readonly property real elev0Alpha:  @elev-0-alpha@
    readonly property real elev0Border: @elev-0-border@

    readonly property real elev1Alpha:       @elev-1-alpha@
    readonly property real elev1Border:      @elev-1-border@
    readonly property int  elev1ShadowY:     @elev-1-shadow-y@
    readonly property int  elev1ShadowBlur:  @elev-1-shadow-blur@
    readonly property real elev1ShadowAlpha: @elev-1-shadow-alpha@

    readonly property real elev2Alpha:       @elev-2-alpha@
    readonly property real elev2Border:      @elev-2-border@
    readonly property int  elev2ShadowY:     @elev-2-shadow-y@
    readonly property int  elev2ShadowBlur:  @elev-2-shadow-blur@
    readonly property real elev2ShadowAlpha: @elev-2-shadow-alpha@

    readonly property real elev3Alpha:       @elev-3-alpha@
    readonly property real elev3Border:      @elev-3-border@
    readonly property int  elev3ShadowY:     @elev-3-shadow-y@
    readonly property int  elev3ShadowBlur:  @elev-3-shadow-blur@
    readonly property real elev3ShadowAlpha: @elev-3-shadow-alpha@

    readonly property int blurSize:   @blur-size@
    readonly property int blurPasses: @blur-passes@

    // ---------------------------------------------------------------------
    // Motion — milliseconds. Hyprland's deciseconds do not cross into QML.
    //
    // The easing curves are exposed as control-point lists because that is what
    // `easing.bezierCurve` takes; the CSS consumers get the same four numbers
    // wrapped in cubic-bezier() by the same renderer.
    // ---------------------------------------------------------------------
    readonly property int dur1: @dur-1@
    readonly property int dur2: @dur-2@
    readonly property int dur3: @dur-3@
    readonly property int dur4: @dur-4@

    readonly property var easeOut:      [@ease-out-points@]
    readonly property var easeStandard: [@ease-standard-points@]
    readonly property var easeReduced:  [@ease-reduced-points@]

    // ---------------------------------------------------------------------
    // Neutrals — fixed by design; only the accent moves. Mirrors
    // hypr/colors.conf, which QML cannot read.
    // ---------------------------------------------------------------------
    readonly property color base:     "#0f1115"
    readonly property color surface:  "#16181d"
    readonly property color elevated: "#1c1f26"
    readonly property color text:     "#f5f5f7"
    readonly property color muted:    "#9a9ca5"
    readonly property color dim:      "#6b6e78"
    readonly property color hairline: "#2a2d35"
    readonly property color warning:  "#e1a346"
    readonly property color error:    "#e5484d"
    readonly property color success:  "#4cae80"
}
