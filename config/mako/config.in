# Notifications — glass cards, top-right, per the design mockup.
# Palette mirror of hypr/colors.conf — keep in sync manually.
# Not reproducible in mako: the mockup's per-card relative timestamp
# ("now" / "2m ago") and the tinted circle behind the icon — mako has no
# timestamp format token and draws app icons as-is, with no icon backdrop.

# mako sizes text in Pango POINTS, not pixels, so this one deliberately does not
# come from the type scale — 10.5pt is the optical match for $text-sm at this
# DPI, and substituting 13 here would render half again too large.
font=@font-ui@ 10.5
width=340
height=140
# outer-margin (edge of screen) + margin (between/around each card) add
# together: 19+5=24px ($space-6) from the screen edge, 5+5=10px ($space-2h)
# between stacked cards. The halves are what mako's two knobs can express, so
# they stay literal — the tokens are the sums, not these operands.
outer-margin=19
margin=5
padding=@space-4@
anchor=top-right

background-color=#12121699
text-color=#c4c0b6
border-color=#FFFFFF1A
border-size=1
border-radius=@radius-md@
icon-border-radius=@radius-sm@

icons=1
max-icon-size=36
markup=1
default-timeout=6000
max-visible=4
layer=overlay

# title bold, body muted — mako styles via markup on format
format=<b>%s</b>\n<span color="#96969e">%b</span>

[urgency=critical]
border-color=@accent-upper@
default-timeout=0

# faded, lower-elevation treatment — mirrors the mockup's older/read card
[urgency=low]
background-color=#12121673
border-color=#FFFFFF0F
text-color=#96969e

[expiring=true]
background-color=#12121673
border-color=#FFFFFF0F
text-color=#96969e

# The fallback Waybar right-click toggles this persistent-for-the-session mode.
[mode=do-not-disturb]
invisible=1
