/* Media player card */
.widget-mpris {
  padding: 0;
}

.widget-mpris .widget-mpris-player {
  margin: 0px @space-2-px@;
  border-radius: @radius-md-px@;
  border: 1px solid @border;
}

.widget-mpris .mpris-overlay {
  padding: @space-3-px@;
  background-color: alpha(@bg, 0.65);
  border-radius: @radius-md-px@;
}

.widget-mpris .widget-mpris-album-art {
  border-radius: @radius-sm-px@;
}

.widget-mpris .widget-mpris-title {
  font-size: @text-md-px@;
  font-weight: @weight-bold@;
  color: @text;
}

.widget-mpris .widget-mpris-subtitle {
  font-size: @text-xs-px@;
  color: @muted;
}

.widget-mpris .mpris-overlay button {
  background: alpha(@text, 0.08);
  border: none;
  border-radius: @radius-pill-px@;
  color: @text;
}

.widget-mpris .mpris-overlay button:hover {
  background-color: @accent-soft;
  color: @accent;
}

/* Quick action buttons */
.widget-buttons-grid {
  margin: 0px @space-2-px@;
}

.widget-buttons-grid flowboxchild {
  padding: @space-1-px@;
}

/* 44px is the design's tile size, shared with the dock — a touch target, not a
   spacing step, so it stays literal alongside $icon-hit. */
.widget-buttons-grid flowboxchild > button {
  background: @surface;
  border: 1px solid @border;
  border-radius: @radius-sm-px@;
  color: @text;
  min-height: 44px;
  min-width: 44px;
  font-size: @text-lg-px@;
  transition:
    background @dur-1-ms@ @ease-standard@,
    border-color @dur-1-ms@ @ease-standard@;
}

.widget-buttons-grid flowboxchild > button:hover {
  background: @elevated;
  border-color: alpha(@accent, 0.5);
}

.widget-buttons-grid flowboxchild > button.toggle:checked {
  background: @accent-soft;
  border-color: @accent;
  color: @accent;
}

/* Volume slider */
.widget-volume {
  padding: @space-3-px@ @space-3-px@;
  background: @surface;
  border: 1px solid @border;
  border-radius: @radius-md-px@;
}

.widget-volume label {
  color: @muted;
  font-size: @text-xs-px@;
  font-weight: @weight-semibold@;
  min-width: 52px;
  margin-right: @space-2h-px@;
}

.widget-slider trough {
  background: alpha(@text, 0.12);
  border-radius: @radius-pill-px@;
  min-height: @space-2-px@;
}

.widget-slider trough highlight {
  background: @accent;
  border-radius: @radius-pill-px@;
  min-height: @space-2-px@;
}

.widget-slider trough slider {
  background: @text;
  border-radius: @radius-pill-px@;
  min-height: @space-4-px@;
  min-width: @space-4-px@;
}

.widget-slider trough slider:hover {
  background: @accent;
}

.per-app-volume {
  background: alpha(@surface, 0.72);
  border-radius: @radius-sm-px@;
}
