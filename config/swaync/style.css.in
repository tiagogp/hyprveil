/* Palette mirror of hypr/colors.conf. SwayNC is GTK4, so the neutrals stay
   self-contained here; the accent is generated from the wallpaper.

   GENERATED from style.css.in by hypr/scripts/theme.sh — edit the template, not
   the rendered style.css. See docs/CONFIGURATION.md.

   Note for editors: GTK's at-name color references and the renderer's
   at-name-at placeholders coexist safely because a substitution needs the
   closing delimiter, which a GTK color reference never has. */
@import url("accent.css");
@define-color bg rgba(9, 9, 11, @elev-0-alpha@);
@define-color surface rgba(18, 18, 22, @elev-0-alpha@);
@define-color elevated rgba(24, 24, 28, @elev-2-alpha@);
@define-color text #c4c0b6;
@define-color muted #96969e;
@define-color dim #6e6e76;
@define-color border rgba(255, 255, 255, @elev-0-border@);
@define-color warning #c29a5e;

* {
  font-family: "@font-ui@", "@font-ui-icons@", sans-serif;
  color: @text;
}

.floating-notifications,
.control-center-list,
.blank-window {
  background: transparent;
}

.control-center {
  background: @bg;
  border: 1px solid @border;
  border-radius: @radius-lg-px@;
}

.notification-row {
  outline: none;
}

.notification-row:focus .notification-background .notification,
.notification-row:hover .notification-background .notification {
  border-color: alpha(@accent, 0.72);
  background: @elevated;
}

.notification-row .notification-background .notification,
.control-center .notification-row .notification-background .notification {
  background: @surface;
  border: 1px solid @border;
  border-radius: @radius-md-px@;
  margin: 0px @space-1-px@;
  padding: 0;
}

.notification-row .notification-background .notification.low {
  background: alpha(@surface, 0.72);
  color: @muted;
}

.notification-row .notification-background .notification.normal {
  border-color: @border;
}

.notification-row .notification-background .notification.critical {
  border-color: @accent;
  background: alpha(@accent, 0.12);
}

.notification.low .summary,
.notification.low .body,
.notification.low .time {
  color: @muted;
}

.notification.critical .summary {
  color: @accent;
}

.notification-content {
  padding: @space-2h-px@ @space-3-px@;
}

.summary {
  font-size: @text-sm-px@;
  font-weight: @weight-bold@;
  color: @text;
  margin-bottom: @space-hair-px@;
}

/* The mockup sizes the timestamp one step below the body rather than equal to
   it, which is what keeps a long app name from reading as part of the message.
   These shared a rule at 12.5px before and so could not be told apart. */
.body {
  color: @muted;
  font-size: @text-xs-px@;
  line-height: 1.3;
}

.time {
  color: @muted;
  font-size: @text-2xs-px@;
  margin-bottom: 0;
}

.notification-default-action,
.notification-action {
  background: transparent;
  border: none;
  border-radius: @radius-sm-px@;
  box-shadow: none;
}

.notification-action {
  background: alpha(@accent, 0.12);
  color: @accent;
  margin: 0 @space-1-px@ @space-2-px@;
  padding: @space-1h-px@ @space-2h-px@;
}

.notification-action:hover,
.notification-action:focus {
  background: @accent-soft;
}

.close-button {
  background: alpha(@text, 0.08);
  border: none;
  border-radius: @radius-pill-px@;
  color: @muted;
  margin: @space-2-px@;
  min-height: @space-6-px@;
  min-width: @space-6-px@;
}

.close-button:hover,
.close-button:focus {
  background: @accent-soft;
  color: @accent;
}

.widget-title {
  margin: @space-1-px@ @space-2-px@;
  padding: @space-1-px@ @space-1h-px@;
}

.widget-dnd {
  margin: 0px @space-2-px@;
  padding: @space-3-px@ @space-3-px@;
  background: @surface;
  border: 1px solid @border;
  border-radius: @radius-md-px@;
}

/* Whole hundreds only. This was 650 — GTK rejects a non-hundred weight and
   discards the ENTIRE stylesheet, so that one declaration was taking every rule
   in this file down with it. */
.widget-title > label,
.widget-dnd > label {
  font-size: @text-md-px@;
  font-weight: @weight-semibold@;
}

.widget-title > button {
  background: alpha(@text, 0.07);
  border: 1px solid @border;
  border-radius: @radius-sm-px@;
  color: @muted;
  padding: @space-1h-px@ @space-2h-px@;
}

.widget-title > button:hover,
.widget-title > button:focus {
  background: @accent-soft;
  color: @accent;
}

/* Switch geometry is bespoke control hardware, not layout: the track and knob
   have to hold a fixed ratio to read as a switch, so the track is deliberately
   off the spacing grid. The knob is $space-5 only because 20 is where it lands. */
.widget-dnd > switch {
  background: alpha(@text, 0.1);
  border: 1px solid @border;
  border-radius: @radius-pill-px@;
  min-width: 46px;
  min-height: 26px;
  transition: background @dur-2-ms@ @ease-standard@;
}

.widget-dnd > switch:checked {
  background: @accent;
}

.widget-dnd > switch slider {
  background: @text;
  border-radius: @radius-pill-px@;
  min-height: @space-5-px@;
  min-width: @space-5-px@;
  margin: 0px;
}

.notification-group {
  background: transparent;
}

.notification-group-headers {
  color: @muted;
  margin: 0px @space-2h-px@;
}

/* Scrollbar */
